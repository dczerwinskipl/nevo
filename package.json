{
  "name": "nevo-repo-tools",
  "private": true,
  "type": "module",
  "description": "Repository-local Node.js tooling for NEvo specs and docs (not published).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test tools/tests/*.test.mjs",
    "specs:check": "node tools/specs.mjs check",
    "docs:check": "node tools/docs.mjs check",
    "dashboard:dev": "node tools/dashboard/server/dev.mjs",
    "dashboard:test": "npm --prefix tools/dashboard test",
    "dashboard:build": "npm --prefix tools/dashboard run build",
    "dashboard:start": "node tools/dashboard/server/index.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  }
}
