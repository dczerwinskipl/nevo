{
  "name": "@nevo/spec-dashboard",
  "private": true,
  "type": "module",
  "description": "Local, file-backed dashboard for the NEvo specification workflow.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 4317",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@git-diff-view/lowlight": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
