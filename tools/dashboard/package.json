{
  "name": "@nevo/spec-dashboard",
  "private": true,
  "type": "module",
  "description": "Local, file-backed dashboard for the NEvo specification workflow.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 4317",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test --test-timeout=15000 tests/*.test.mjs",
    "start": "node server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o .storybook/dist",
    "test:storybook": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@fastify/autoload": "^6.5.0",
    "@fastify/sse": "^0.6.0",
    "@fastify/static": "^10.1.3",
    "@git-diff-view/lowlight": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.32",
    "@yornaath/batshit": "^0.14.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.1",
    "lucide-react": "^1.31.0",
    "nevo-repo-tools": "file:../..",
    "picomatch": "^4.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
